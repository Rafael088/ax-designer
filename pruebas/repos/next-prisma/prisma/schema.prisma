generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]
  @@map("categorias")
}

model Producto {
  id          Int       @id @default(autoincrement())
  nombre      String
  precio      Float
  stock       Int       @default(0)
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  createdAt   DateTime  @default(now())
  @@map("productos")
}

model Orden {
  id        Int         @id @default(autoincrement())
  email     String
  nota      String?
  estado    EstadoOrden @default(PENDIENTE)
  total     Float
  updatedAt DateTime    @updatedAt
  @@map("ordenes")
}

enum EstadoOrden {
  PENDIENTE
  PAGADA
}
